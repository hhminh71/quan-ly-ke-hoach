/**
 * Trợ giúp format ngày tháng YYYY-MM-DD
 */
function formatDate(val) {
  if (!val) return '';
  if (val instanceof Date) {
    return Utilities.formatDate(val, 'GMT+7', 'yyyy-MM-dd');
  }
  return String(val);
}

/**
 * Xử lý tải file Excel Bravo từ link hoặc ID thư mục/file Google Drive
 */
function handleFetchBravoFromDrive(driveUrlOrId) {
  let urlOrId = driveUrlOrId ? String(driveUrlOrId).trim() : '';
  if (!urlOrId) {
    try {
      urlOrId = PropertiesService.getScriptProperties().getProperty('BRAVO_DRIVE_FOLDER_URL') || '';
    } catch (e) {}
  }

  if (!urlOrId) {
    return createJsonResponse({
      status: 'error',
      message: 'Chưa cấu hình Link thư mục Google Drive. Vui lòng liên hệ Admin để cài đặt link thư mục.'
    });
  }

  try {
    let targetFile = null;
    let folderName = '';

    // Trích xuất Folder ID hoặc File ID từ link
    const str = urlOrId;
    let extractedId = str;
    const folderMatch = str.match(/folders\/([a-zA-Z0-9_-]+)/);
    const fileMatch = str.match(/\/d\/([a-zA-Z0-9_-]+)/);
    const idParam = str.match(/[?&]id=([a-zA-Z0-9_-]+)/);

    if (folderMatch) {
      extractedId = folderMatch[1];
    } else if (fileMatch) {
      extractedId = fileMatch[1];
    } else if (idParam) {
      extractedId = idParam[1];
    }

    // 1. Thử mở như Thư mục (Folder) để tìm file Excel mới nhất
    try {
      const folder = DriveApp.getFolderById(extractedId);
      folderName = folder.getName();
      const files = folder.getFiles();
      let latestTime = 0;

      while (files.hasNext()) {
        const f = files.next();
        const fname = f.getName().toLowerCase();
        // Lọc file Excel (.xlsx hoặc .xls)
        if (fname.indexOf('.xlsx') !== -1 || fname.indexOf('.xls') !== -1) {
          const updated = f.getLastUpdated().getTime();
          if (updated > latestTime) {
            latestTime = updated;
            targetFile = f;
          }
        }
      }
    } catch (folderErr) {
      // 2. Nếu không phải folder hoặc lỗi, thử mở trực tiếp như File
      try {
        targetFile = DriveApp.getFileById(extractedId);
      } catch (fileErr) {
        return createJsonResponse({
          status: 'error',
          message: 'Không thể truy cập Google Drive với link/ID này. Hãy đảm bảo tài khoản Google đã được chia sẻ quyền xem thư mục/file: ' + folderErr.message
        });
      }
    }

    if (!targetFile) {
      return createJsonResponse({
        status: 'error',
        message: 'Không tìm thấy file Excel (.xlsx / .xls) nào trong thư mục Google Drive' + (folderName ? ' "' + folderName + '"' : '')
      });
    }

    const blob = targetFile.getBlob();
    const base64 = Utilities.base64Encode(blob.getBytes());

    return createJsonResponse({
      status: 'success',
      fileName: targetFile.getName(),
      folderName: folderName,
      fileSize: blob.getBytes().length,
      lastUpdated: Utilities.formatDate(targetFile.getLastUpdated(), 'GMT+7', 'dd/MM/yyyy HH:mm:ss'),
      base64: base64
    });
  } catch (err) {
    return createJsonResponse({ status: 'error', message: 'Lỗi xử lý Google Drive: ' + err.toString() });
  }
}

/**
 * HÀM CẤP QUYỀN TRUY CẬP GOOGLE DRIVE (OAuth Scope: DriveApp)
 * 
 * LƯU Ý BẢO MẬT CỦA GOOGLE:
 * Google KHÔNG cho phép mở popup cấp quyền từ menu trên Google Sheet.
 * Bạn PHẢI bấm nút "▶ Chạy" (Run) trực tiếp trong màn hình Apps Script:
 * 1. Ở ô chọn hàm (trên thanh công cụ Apps Script), chọn: capQuyenTruyCapGoogleDrive
 * 2. Bấm nút "▶ Chạy" (Run).
 * 3. Google sẽ hiện hộp thoại "Yêu cầu cấp quyền" (Review Permissions) -> Chọn Cho phép (Allow).
 */
function capQuyenTruyCapGoogleDrive() {
  const root = DriveApp.getRootFolder();
  Logger.log('Đã kết nối thành công thư mục: ' + root.getName());

  try {
    SpreadsheetApp.getUi().alert(
      '✅ CẤP QUYỀN TRUY CẬP GOOGLE DRIVE THÀNH CÔNG!\n\n' +
      'Tài khoản Google của bạn đã chính thức cấp quyền cho Apps Script đọc thư mục Bravo trên Google Drive.\n\n' +
      '👉 Bây giờ bạn có thể quay lại Web App và bấm nút "Đồng Bộ Ngay Từ Google Drive (1-Click)".'
    );
  } catch (e) {
    Logger.log('Đã cấp quyền thành công trong Apps Script Editor!');
  }
}

/**
 * Tạo phản hồi JSON chuẩn CORS cho Web App
 */
function createJsonResponse(data) {
  return ContentService.createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}

