/**
 * GOOGLE APPS SCRIPT CHO HỆ THỐNG QUẢN LÝ KẾ HOẠCH & CHI PHÍ
 * 
 * Hướng dẫn sử dụng:
 * 1. Mở file Google Sheets trên trình duyệt: https://sheets.google.com
 * 2. Vào menu: Tiện ích mở rộng (Extensions) -> Apps Script
 * 3. Xóa hết code cũ, dán toàn bộ file này vào và bấm LƯU (Ctrl + S).
 * 4. Bấm "Triển khai" (Deploy) -> "Tùy chọn triển khai mới" (New deployment).
 *    - Chọn loại: Ứng dụng web (Web app)
 *    - Thực thi dưới dạng: Tôi (Me)
 *    - Ai có quyền truy cập: Bất kỳ ai (Anyone)
 *    - Bấm Triển khai và sao chép link Web App URL dán vào Web App.
 * 5. Bấm F5 trên trang Google Sheets: Menu "📊 QUẢN LÝ KẾ HOẠCH" sẽ xuất hiện.
 */

const SHEET_TRANSACTIONS = 'SO_CAI_PHIEU_CHI';
const SHEET_BUDGETS = 'KE_HOACH_NGAN_SACH';
const SHEET_USERS = 'QUAN_TRI_USER';

/**
 * Menu tùy chỉnh tự động hiện lên thanh công cụ của Google Sheets
 */
function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('📊 QUẢN LÝ KẾ HOẠCH')
    .addItem('⚡ 1. Tự động tạo Sheet Kế Hoạch Đa Năm (76 Mã Khoản Mục)', 'setupKeHoachNganSachSheet')
    .addItem('📋 2. Tự động nạp 1.216 Phiếu Chi Lịch Sử vào Sổ Cái (Có Cột Năm)', 'napToanBo1216PhieuChi')
    .addItem('👥 3. Tự động tạo Sheet Quản Trị User (Phân Quyền)', 'setupQuanTriUserSheet')
    .addItem('📁 4. Cấp quyền truy cập Google Drive (Đọc Bravo)', 'capQuyenTruyCapGoogleDrive')
    .addToUi();
}

/**
 * Xử lý yêu cầu GET: Đọc toàn bộ dữ liệu trả về cho Web App
 */
function doGet(e) {
  try {
    const action = (e && e.parameter && e.parameter.action) ? e.parameter.action : 'getData';
    const ss = SpreadsheetApp.getActiveSpreadsheet();

    ensureSheetsInitialized(ss);

    if (action === 'getData') {
      const transactions = getTransactionsFromSheet(ss);
      const budgets = getBudgetsFromSheet(ss);
      const bravoInfo = getBravoInfoFromSheet(ss);
      const users = getUsersFromSheet(ss);

      const scriptProperties = PropertiesService.getScriptProperties();
      const bravoDriveUrl = scriptProperties.getProperty('BRAVO_DRIVE_FOLDER_URL') || '';

      return createJsonResponse({
        status: 'success',
        transactions: transactions,
        budgets: budgets,
        bravoInfo: bravoInfo,
        users: users,
        bravoDriveUrl: bravoDriveUrl,
        serverTime: new Date().toISOString()
      });
    }

    if (action === 'fetchBravoFromDrive') {
      const driveUrlOrId = e.parameter.driveUrl || e.parameter.folderUrl || e.parameter.url;
      return handleFetchBravoFromDrive(driveUrlOrId);
    }

    return createJsonResponse({ status: 'error', message: 'Action không hợp lệ' });
  } catch (err) {
    return createJsonResponse({ status: 'error', message: err.toString() });
  }
}

/**
 * Xử lý yêu cầu POST: Thêm mới, cập nhật hoặc xóa phiếu từ Web App
 */
function doPost(e) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    ensureSheetsInitialized(ss);

    let data = {};
    if (e && e.postData && e.postData.contents) {
      data = JSON.parse(e.postData.contents);
    }

    const action = data.action;

    // 1. Thêm 1 phiếu mới
    if (action === 'addTransaction') {
      const t = data.transaction;
      if (!t) throw new Error('Không có dữ liệu phiếu chi');

      const dateStr = t.date || new Date().toISOString().split('T')[0];
      const year = dateStr.length >= 4 ? dateStr.substring(0, 4) : new Date().getFullYear();

      const sheet = ss.getSheetByName(SHEET_TRANSACTIONS);
      sheet.appendRow([
        t.id || Date.now(),
        year,
        dateStr,
        t.accountCode || '',
        t.category || '',
        t.group || '',
        t.employeeName || '',
        Number(t.amount) || 0,
        t.notes || '',
        t.createdAt || Utilities.formatDate(new Date(), 'GMT+7', 'HH:mm')
      ]);

      return createJsonResponse({
        status: 'success',
        message: 'Đã thêm phiếu vào Google Sheet thành công',
        id: t.id
      });
    }

    // 2. Xóa 1 phiếu theo ID
    if (action === 'deleteTransaction') {
      const idToDelete = String(data.id);
      const sheet = ss.getSheetByName(SHEET_TRANSACTIONS);
      const rows = sheet.getDataRange().getValues();
      let deleted = false;

      for (let i = 1; i < rows.length; i++) {
        if (String(rows[i][0]) === idToDelete) {
          sheet.deleteRow(i + 1);
          deleted = true;
          break;
        }
      }

      return createJsonResponse({
        status: 'success',
        message: deleted ? 'Đã xóa phiếu thành công' : 'Không tìm thấy ID để xóa'
      });
    }

    // 3. Cập nhật nội dung 1 phiếu theo ID (Đồng bộ tức thì)
    if (action === 'updateTransaction') {
      const t = data.transaction;
      if (!t || !t.id) throw new Error('Không có thông tin phiếu cần cập nhật');

      const idToUpdate = String(t.id);
      const sheet = ss.getSheetByName(SHEET_TRANSACTIONS);
      const rows = sheet.getDataRange().getValues();
      let updated = false;

      for (let i = 1; i < rows.length; i++) {
        if (String(rows[i][0]) === idToUpdate) {
          const rowIdx = i + 1;
          const dateStr = t.date || String(rows[i][2]);
          const year = t.fiscalYear || (dateStr.length >= 4 ? dateStr.substring(0, 4) : '');

          sheet.getRange(rowIdx, 2, 1, 9).setValues([[
            year,
            dateStr,
            t.accountCode || '',
            t.category || '',
            t.group || '',
            t.employeeName || '',
            Number(t.amount) || 0,
            t.notes || '',
            t.createdAt || rows[i][9] || '09:00'
          ]]);
          updated = true;
          break;
        }
      }

      return createJsonResponse({
        status: 'success',
        message: updated ? 'Đã cập nhật phiếu trên Google Sheet thành công' : 'Không tìm thấy ID',
        id: t.id
      });
    }

    // 4. Đồng bộ toàn bộ dữ liệu đối soát từ file Excel Bravo Daily vào sheet INFO
    if (action === 'syncBravoInfo') {
      const items = data.items;
      const updateTime = data.updateTime || Utilities.formatDate(new Date(), 'GMT+7', 'dd/MM/yyyy HH:mm:ss');
      if (!Array.isArray(items) || items.length === 0) {
        throw new Error('Dữ liệu kết xuất Bravo rỗng');
      }

      let infoSheet = ss.getSheetByName('INFO');
      if (!infoSheet) {
        infoSheet = ss.insertSheet('INFO');
      }

      const rowsToSet = [];
      // Dòng 1: Tiêu đề báo cáo và Ghi chú thời gian cập nhật Bravo ở ô H1
      rowsToSet.push(['NƠI NHẬP DỮ LIỆU TỪ PHẦN MỀM KẾ TOÁN BRAVO ĐỂ SO SÁNH', '', '', '', '', '', '', 'CẬP NHẬT LÚC: ' + updateTime]);
      // Dòng 2: Cột B2 PHẢI ĐỂ TRỐNG y hệt file gốc để không phá vỡ hàm =VLOOKUP(C4; INFO!$B$2:$F$164; 5; 1)
      rowsToSet.push(['', '', '', 'Giá trị', 'Tỷ lệ', 'Giá trị', 'Tỷ lệ', 'Thời gian cập nhật Bravo']);

      items.forEach(function(item) {
        rowsToSet.push([
          item.name || '',
          item.code ? String(item.code) : '',
          Number(item.approvedAmount) || 0,
          Number(item.bravoAmount) || 0,
          Number(item.rate) || 0,
          Number(item.actualYTD) || 0,
          Number(item.rateYTD) || 0,
          item.updateTime || updateTime
        ]);
      });

      infoSheet.clear();
      infoSheet.getRange(1, 1, rowsToSet.length, rowsToSet[0].length).setValues(rowsToSet);

      // Định dạng làm đẹp trực quan cho Sheet INFO
      try {
        infoSheet.getRange('A1:H1').setFontWeight('bold').setBackground('#e0f2fe').setFontColor('#0369a1');
        infoSheet.getRange('A2:H2').setFontWeight('bold').setBackground('#f1f5f9').setFontColor('#334155');
        infoSheet.setFrozenRows(2);
      } catch (styleErr) {}

      return createJsonResponse({
        status: 'success',
        message: 'Đã cập nhật thành công ' + items.length + ' dòng vào sheet INFO lúc ' + updateTime,
        updateTime: updateTime,
        count: items.length
      });
    }

    // 5. Tải file Excel Bravo mới nhất từ thư mục hoặc file Google Drive được share
    if (action === 'fetchBravoFromDrive') {
      const driveUrlOrId = data.driveUrl || data.folderUrl || data.url;
      return handleFetchBravoFromDrive(driveUrlOrId);
    }

    // 6. Lưu cấu hình link thư mục Google Drive cố định cho toàn hệ thống (Chỉ Admin)
    if (action === 'saveBravoDriveUrl') {
      const url = String(data.url || data.driveUrl || '').trim();
      PropertiesService.getScriptProperties().setProperty('BRAVO_DRIVE_FOLDER_URL', url);
      return createJsonResponse({
        status: 'success',
        message: 'Đã lưu cấu hình link thư mục Google Drive cố định thành công',
        url: url
      });
    }

    
    // 5. Lưu (Thêm mới hoặc Cập nhật) User phân quyền
    if (action === 'saveUser') {
      const u = data.user;
      if (!u || !u.email) throw new Error('Thiếu email người dùng');
      const emailToSave = String(u.email).trim().toLowerCase();
      let sheet = ss.getSheetByName(SHEET_USERS);
      if (!sheet) {
        setupQuanTriUserSheet();
        sheet = ss.getSheetByName(SHEET_USERS);
      }
      const rows = sheet.getDataRange().getValues();
      const header = rows[0].map(function(h) { return String(h).trim().toLowerCase(); });
      const hasScopeCol = header.some(function(h) { return h.includes('phạm vi') || h.includes('scope'); });
      const customCodesStr = Array.isArray(u.allowedCodes) ? u.allowedCodes.join(', ') : String(u.allowedCodes || '');
      let updated = false;

      for (let i = 1; i < rows.length; i++) {
        if (String(rows[i][0]).trim().toLowerCase() === emailToSave) {
          const rowIdx = i + 1;
          if (hasScopeCol) {
            sheet.getRange(rowIdx, 2, 1, 9).setValues([[
              u.name || rows[i][1],
              u.password || rows[i][2] || '123456',
              u.department || rows[i][3],
              (u.role || rows[i][4] || 'VIEWER').toUpperCase(),
              (u.expenseScope || rows[i][5] || 'ALL').toUpperCase(),
              customCodesStr,
              (u.status || rows[i][7] || 'HOAT_DONG').toUpperCase(),
              Utilities.formatDate(new Date(), 'GMT+7', 'dd/MM/yyyy HH:mm'),
              u.notes || rows[i][9] || ''
            ]]);
          } else {
            sheet.getRange(rowIdx, 2, 1, 6).setValues([[
              u.name || rows[i][1],
              u.department || rows[i][2],
              (u.role || rows[i][3] || 'VIEWER').toUpperCase(),
              (u.status || rows[i][4] || 'HOAT_DONG').toUpperCase(),
              Utilities.formatDate(new Date(), 'GMT+7', 'dd/MM/yyyy HH:mm'),
              u.notes || rows[i][6] || ''
            ]]);
          }
          updated = true;
          break;
        }
      }

      if (!updated) {
        if (hasScopeCol) {
          sheet.appendRow([
            emailToSave,
            u.name || emailToSave.split('@')[0],
            u.password || '123456',
            u.department || 'Phòng TC-KH',
            (u.role || 'VIEWER').toUpperCase(),
            (u.expenseScope || 'ALL').toUpperCase(),
            customCodesStr,
            (u.status || 'HOAT_DONG').toUpperCase(),
            Utilities.formatDate(new Date(), 'GMT+7', 'dd/MM/yyyy HH:mm'),
            u.notes || ''
          ]);
        } else {
          sheet.appendRow([
            emailToSave,
            u.name || emailToSave.split('@')[0],
            u.department || 'Phòng TC-KH',
            (u.role || 'VIEWER').toUpperCase(),
            (u.status || 'HOAT_DONG').toUpperCase(),
            Utilities.formatDate(new Date(), 'GMT+7', 'dd/MM/yyyy HH:mm'),
            u.notes || ''
          ]);
        }
      }

      return createJsonResponse({
        status: 'success',
        message: updated ? 'Đã cập nhật quyền người dùng thành công' : 'Đã thêm mới người dùng thành công',
        user: u
      });
    }

    // 6. Xóa User khỏi danh sách phân quyền
    if (action === 'deleteUser') {
      const emailToDelete = String(data.email || '').trim().toLowerCase();
      if (!emailToDelete) throw new Error('Thiếu email cần xóa');
      const sheet = ss.getSheetByName(SHEET_USERS);
      if (!sheet) throw new Error('Sheet Quản trị User chưa được khởi tạo');
      const rows = sheet.getDataRange().getValues();
      let deleted = false;

      for (let i = 1; i < rows.length; i++) {
        if (String(rows[i][0]).trim().toLowerCase() === emailToDelete) {
          sheet.deleteRow(i + 1);
          deleted = true;
          break;
        }
      }

      return createJsonResponse({
        status: 'success',
        message: deleted ? 'Đã xóa quyền người dùng thành công' : 'Không tìm thấy email'
      });
    }

    return createJsonResponse({ status: 'error', message: 'Hành động POST không hợp lệ' });
  } catch (err) {
    return createJsonResponse({ status: 'error', message: err.toString() });
  }
}

/**
 * Hàm lấy danh sách giao dịch từ sheet SO_CAI_PHIEU_CHI
 * Tự động nhận diện linh hoạt các cột theo tiêu đề (Hỗ trợ cả có hoặc không có cột Năm)
 */
function getTransactionsFromSheet(ss) {
  const sheet = ss.getSheetByName(SHEET_TRANSACTIONS);
  const rows = sheet.getDataRange().getValues();
  if (rows.length <= 1) return [];

  const header = rows[0].map(function(h) { return String(h).trim().toLowerCase(); });
  const idIdx = header.findIndex(function(h) { return h.includes('id'); });
  const yearIdx = header.findIndex(function(h) { return h === 'năm' || h.includes('năm'); });
  const dateIdx = header.findIndex(function(h) { return h.includes('ngày'); });
  const codeIdx = header.findIndex(function(h) { return h.includes('mã'); });
  const nameIdx = header.findIndex(function(h) { return h.includes('tên'); });
  const groupIdx = header.findIndex(function(h) { return h.includes('nhóm'); });
  const personIdx = header.findIndex(function(h) { return h.includes('người') || h.includes('nhân sự'); });
  const amountIdx = header.findIndex(function(h) { return h.includes('tiền') || h.includes('số tiền'); });
  const notesIdx = header.findIndex(function(h) { return h.includes('nội dung') || h.includes('ghi chú'); });
  const timeIdx = header.findIndex(function(h) { return h.includes('thời gian') || h.includes('giờ'); });

  const list = [];
  for (let i = 1; i < rows.length; i++) {
    const r = rows[i];
    const rawId = idIdx >= 0 ? r[idIdx] : r[0];
    const rawAmount = amountIdx >= 0 ? r[amountIdx] : r[7];
    if (!rawId && !rawAmount) continue;

    const dateVal = formatDate(dateIdx >= 0 ? r[dateIdx] : r[2]);
    let yearVal = yearIdx >= 0 ? String(r[yearIdx]) : '';
    if (!yearVal && dateVal && dateVal.length >= 4) {
      yearVal = dateVal.substring(0, 4);
    }

    list.push({
      id: rawId,
      fiscalYear: yearVal,
      date: dateVal,
      accountCode: String((codeIdx >= 0 ? r[codeIdx] : r[3]) || ''),
      category: String((nameIdx >= 0 ? r[nameIdx] : r[4]) || ''),
      group: String((groupIdx >= 0 ? r[groupIdx] : r[5]) || ''),
      employeeName: String((personIdx >= 0 ? r[personIdx] : r[6]) || ''),
      amount: Number(rawAmount) || 0,
      notes: String((notesIdx >= 0 ? r[notesIdx] : r[8]) || ''),
      createdAt: String((timeIdx >= 0 ? r[timeIdx] : r[9]) || '09:00'),
      status: 'Đã thực hiện'
    });
  }
  return list;
}

/**
 * Hàm lấy danh sách 76 khoản mục từ sheet KE_HOACH_NGAN_SACH (Hỗ trợ đa cột năm 2024, 2025, 2026, 2027...)
 */
function getBudgetsFromSheet(ss) {
  const sheet = ss.getSheetByName(SHEET_BUDGETS);
  const rows = sheet.getDataRange().getValues();
  if (rows.length <= 1) return [];

  const header = rows[0];
  const yearCols = [];
  for (let c = 3; c < header.length; c++) {
    const hText = String(header[c]);
    const match = hText.match(/20\d{2}/);
    if (match) {
      yearCols.push({ year: match[0], colIndex: c });
    }
  }

  const list = [];
  for (let i = 1; i < rows.length; i++) {
    const r = rows[i];
    if (!r[0]) continue;

    const yearlyApproved = {};
    yearCols.forEach(function(yc) {
      yearlyApproved[yc.year] = Number(r[yc.colIndex]) || 0;
    });

    list.push({
      code: String(r[0]),
      name: String(r[1] || ''),
      group: String(r[2] || 'SỬA CHỮA THƯỜNG XUYÊN'),
      approved: yearlyApproved['2026'] || 0,
      yearlyApproved: yearlyApproved,
      scope: String(r[header.length - 1] || '')
    });
  }
  return list;
}

/**
 * Hàm lấy toàn bộ thông tin đối soát từ sheet INFO (kết xuất từ phần mềm BRAVO) nếu có
 */
function getBravoInfoFromSheet(ss) {
  const sheet = ss.getSheetByName('INFO');
  if (!sheet) return null;
  const rows = sheet.getDataRange().getValues();
  if (rows.length <= 2) return null;

  const updateTimeNote = String(rows[0][1] || '').trim();

  const list = [];
  let currentCategory = 'TỔNG THỂ CHI PHÍ';

  for (let i = 2; i < rows.length; i++) {
    const r = rows[i];
    const name = String(r[0] || '').trim();
    const code = String(r[1] || '').trim();
    const approved = Number(r[2]) || 0;
    const bravo = Number(r[3]) || 0;
    const rate = Number(r[4]) || 0;
    const actualYTD = Number(r[5]) || 0;
    const rateYTD = Number(r[6]) || 0;
    const updateTime = String(r[7] || updateTimeNote).trim();

    if (!name && !code) continue;
    if (!code && name) {
      currentCategory = name;
    }

    list.push({
      row: i + 1,
      code: code,
      name: name,
      category: currentCategory,
      approvedAmount: approved,
      bravoAmount: bravo,
      rate: rate > 0 && rate < 10 ? Math.round(rate * 10000) / 100 : Math.round(rate * 100) / 100,
      actualYTD: actualYTD,
      rateYTD: rateYTD > 0 && rateYTD < 10 ? Math.round(rateYTD * 10000) / 100 : Math.round(rateYTD * 100) / 100,
      updateTime: updateTime,
      note: updateTime
    });
  }
  return list;
}

/**
 * Đảm bảo 2 sheet cần thiết luôn tồn tại và có tiêu đề
 */

/**
 * Lấy danh sách tài khoản phân quyền từ sheet QUAN_TRI_USER
 */
function getUsersFromSheet(ss) {
  const sheet = ss.getSheetByName(SHEET_USERS);
  if (!sheet) return [];
  const rows = sheet.getDataRange().getValues();
  if (rows.length <= 1) return [];

  const header = rows[0].map(function(h) { return String(h).trim().toLowerCase(); });
  const emailIdx = header.findIndex(function(h) { return h.includes('email') || h.includes('tài khoản'); });
  const nameIdx = header.findIndex(function(h) { return h.includes('tên') || h.includes('họ'); });
  const passIdx = header.findIndex(function(h) { return h.includes('mật khẩu') || h.includes('pass'); });
  const deptIdx = header.findIndex(function(h) { return h.includes('phòng') || h.includes('bộ phận'); });
  const roleIdx = header.findIndex(function(h) { return h.includes('vai trò') || h.includes('role') || h.includes('quyền'); });
  const scopeIdx = header.findIndex(function(h) { return h.includes('phạm vi') || h.includes('scope'); });
  const customCodesIdx = header.findIndex(function(h) { return h.includes('mã') && (h.includes('tùy chọn') || h.includes('cho phép')); });
  const statusIdx = header.findIndex(function(h) { return h.includes('trạng thái') || h.includes('status'); });
  const dateIdx = header.findIndex(function(h) { return h.includes('ngày'); });
  const noteIdx = header.findIndex(function(h) { return h.includes('ghi chú') || h.includes('note'); });

  const list = [];
  for (let i = 1; i < rows.length; i++) {
    const r = rows[i];
    const email = String(emailIdx >= 0 ? r[emailIdx] : r[0] || '').trim();
    if (!email) continue;
    
    // Auto-detect default scope if not set in sheet
    let scopeVal = 'ALL';
    if (scopeIdx >= 0 && r[scopeIdx]) {
      scopeVal = String(r[scopeIdx]).trim().toUpperCase();
    } else if (email.includes('kythuat')) {
      scopeVal = 'KY_THUAT';
    } else if (email.includes('xaydung')) {
      scopeVal = 'XAY_DUNG';
    } else if (email.includes('daotao')) {
      scopeVal = 'DAO_TAO';
    }

    const rawAllowedCodes = customCodesIdx >= 0 ? String(r[customCodesIdx] || '').trim() : '';
    let allowedCodes = rawAllowedCodes ? rawAllowedCodes.split(',').map(function(s) { return s.trim(); }).filter(Boolean) : [];

    // Hỗ trợ nếu người dùng nhập trực tiếp các mã tài khoản vào cột Phạm vi chi phí
    if (allowedCodes.length === 0 && /\d{3,}/.test(scopeVal)) {
      allowedCodes = scopeVal.split(/[,;\s]+/).map(function(s) { return s.trim(); }).filter(function(s) { return /\d{3,}/.test(s); });
    }

    list.push({
      email: email,
      name: String(nameIdx >= 0 ? r[nameIdx] : r[1] || email.split('@')[0]).trim(),
      password: String(passIdx >= 0 ? r[passIdx] : (email.includes('admin') ? 'admin123' : email.includes('ketoan') ? 'ketoan123' : '123456')).trim(),
      department: String(deptIdx >= 0 ? r[deptIdx] : (passIdx >= 0 ? r[3] : r[2]) || '').trim(),
      role: String(roleIdx >= 0 ? r[roleIdx] : (passIdx >= 0 ? r[4] : r[3]) || 'VIEWER').trim().toUpperCase(),
      expenseScope: scopeVal,
      allowedCodes: allowedCodes,
      status: String(statusIdx >= 0 ? r[statusIdx] : (passIdx >= 0 ? r[5] : r[4]) || 'HOAT_DONG').trim().toUpperCase(),
      createdAt: String(dateIdx >= 0 ? r[dateIdx] : (passIdx >= 0 ? r[6] : r[5]) || '').trim(),
      notes: String(noteIdx >= 0 ? r[noteIdx] : (passIdx >= 0 ? r[7] : r[6]) || '').trim()
    });
  }
  return list;
}

